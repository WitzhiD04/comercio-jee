    {
      "name": "1 - Pedido válido (CONFIRMADO)",
      "item": [
        {
          "name": "1.1 Inventario antes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/inventory",
