          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const inv = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('stock_2', inv.find(p => p.productId === 2).stock);",
                  "pm.collectionVariables.set('stock_3', inv.find(p => p.productId === 3).stock);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Crear pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"cliente-1\",\n  \"items\": [\n    {\n      \"productId\": 2,\n      \"quantity\": 2\n    },\n    {\n      \"productId\": 3,\n      \"quantity\": 1\n    }\n  ],\n  \"paymentMethod\": \"TARJETA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test('Responde orderId y estado PENDIENTE', () => {",
                  "    pm.expect(body.orderId).to.be.a('string');",
                  "    pm.expect(body.status).to.eql('PENDIENTE');",
                  "});",
                  "pm.collectionVariables.set('orderOk', body.orderId);",
                  "pm.collectionVariables.set('pollTries', 0);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Esperar estado final (reintento)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderOk}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderOk}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// La SAGA es asíncrona: se repite esta misma petición (cada 500 ms, máx. 30 veces)",
                  "// hasta que el pedido llegue a un estado final. Requiere el Collection Runner o newman.",
                  "const finals = ['CONFIRMADO', 'CANCELADO'];",
                  "const tries = Number(pm.collectionVariables.get('pollTries') || 0);",
                  "const status = pm.response.code === 200 ? pm.response.json().status : 'SIN_PROYECCION';",
                  "console.log('Intento ' + (tries + 1) + ': ' + status);",
                  "if (!finals.includes(status) && tries < 30) {",
                  "    pm.collectionVariables.set('pollTries', tries + 1);",
                  "    setTimeout(() => {}, 500);",
                  "    const next = pm.info.requestName;",
                  "    (pm.execution && pm.execution.setNextRequest) ? pm.execution.setNextRequest(next) : postman.setNextRequest(next);",
                  "} else {",
                  "    pm.collectionVariables.set('pollTries', 0);",
                  "    pm.test('El pedido termina en CONFIRMADO', () => pm.expect(status).to.eql('CONFIRMADO'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Traza de la SAGA",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderOk}}/saga",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderOk}}",
                "saga"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const saga = pm.response.json();",
                  "pm.test('SAGA COMPLETADA', () => pm.expect(saga.status).to.eql('COMPLETADA'));",
                  "pm.test('Pasos registrados', () => {",
                  "    const steps = saga.steps.map(s => s.name + ':' + s.action + ':' + s.result);",
                  "    pm.expect(steps).to.include.members([\"RESERVAR_INVENTARIO:EJECUTAR:OK\", \"PROCESAR_PAGO:EJECUTAR:OK\", \"CONFIRMAR_PEDIDO:EJECUTAR:OK\"]);",
                  "});"
                ]
              }
            }
          ]
        },
