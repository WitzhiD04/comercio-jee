@startuml architecture
title comercio-jee — Arquitectura (CQRS + SAGA orquestada + JTA/XA)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle rectangle
skinparam ArrowColor #444444
skinparam nodesep 50
skinparam ranksep 45

actor Cliente

rectangle "Payara 7 · WAR comercio-jee" {
  rectangle "Escritura (comandos)" #E3F2FD {
    [API de comandos\nPOST · PUT · PATCH · DELETE] as CMD
    [Servicios de dominio\nProductos · Pedidos · Inventario · Pagos] as DOM
    [Orquestador SAGA\n1 paso = 1 transacción JTA/XA] as SAGA
  }
  rectangle "Lectura (consultas)" #E8F5E9 {
    [API de consultas\nGET] as QRY
    [Proyecciones CQRS\n@Observes AFTER_SUCCESS] as PROJ
  }
}

database "orders_db" as ODB
database "inventory_db" as IDB
database "payments_db" as PDB
database "query_db" as QDB

Cliente --> CMD
Cliente --> QRY
CMD --> DOM
DOM -right-> SAGA : OrderPlaced\n(asíncrono)
SAGA -left-> DOM : pasos y\ncompensaciones
DOM --> ODB
DOM --> IDB
DOM --> PDB
DOM .right.> PROJ : eventos\nde dominio
PROJ --> QDB
QRY -[hidden]-> PROJ
QRY --> QDB

legend bottom
  <b>JTA/XA:</b> cada paso de la SAGA escribe en 2 bases con commit en dos fases
  (inventory_db o payments_db + estado del pedido y bitácora en orders_db).
  <b>CQRS:</b> las vistas de query_db se actualizan después del commit (consistencia eventual).
endlegend
@enduml
