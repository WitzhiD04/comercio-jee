@startuml saga-sequence-happy
title SAGA de pedido — flujo feliz (CONFIRMADO / COMPLETADA)
skinparam shadowing false
skinparam defaultFontName Arial
autonumber "<b>0."

actor Cliente
participant "OrderCommandResource" as API
participant "OrderCommandService" as OCS
participant "OrderSagaOrchestrator" as ORCH
participant "OrderSagaSteps" as STEPS
participant "InventoryCommandService" as INV
participant "PaymentCommandService" as PAY
database "orders_db" as ODB
database "inventory_db" as IDB
database "payments_db" as PDB
participant "Proyectores\n(queryPU)" as PROJ

Cliente -> API : POST /orders {customerId, items, paymentMethod}
group JTA (REQUIRED) — orders_db
  API -> OCS : placeOrder()
  OCS -> ODB : INSERT orders (PENDIENTE), order_items
  OCS -> OCS : fire(OrderStatusChanged), fire(OrderPlaced)
end
OCS --> PROJ : AFTER_SUCCESS → OrderSummaryView PENDIENTE
OCS --> ORCH : AFTER_SUCCESS OrderPlaced
ORCH ->> ORCH : ManagedExecutorService.submit(execute)
API --> Cliente : 202 Accepted {orderId, status: PENDIENTE}

== Hilo del ManagedExecutorService ==
ORCH -> STEPS : start(orderId)
STEPS -> ODB : INSERT saga_instances (INICIADA)

group Paso 1 — JTA XA (REQUIRES_NEW): inventory_db + orders_db
  ORCH -> STEPS : reserveInventory(orderId, items)
  STEPS -> INV : reserve() [PESSIMISTIC_WRITE]
  INV -> IDB : reserved += qty; INSERT reservas RESERVADA
  STEPS -> ODB : pedido → INVENTARIO_RESERVADO; SagaStep OK
  note over IDB, ODB : 2PC: PREPARE TRANSACTION en ambas → COMMIT PREPARED
end
STEPS --> PROJ : AFTER_SUCCESS → stock/reservado y estado
ORCH -> ORCH : push(compensación LIBERAR_INVENTARIO)

group Paso 2 — JTA XA (REQUIRES_NEW): payments_db + orders_db
  ORCH -> STEPS : processPayment(orderId, amount)
  STEPS -> PAY : process() → pasarela simulada APROBADO
  PAY -> PDB : INSERT payments (APROBADO)
  STEPS -> ODB : pedido → PAGO_APROBADO; SagaStep OK
end

group Paso 3 — JTA XA (REQUIRES_NEW): inventory_db + orders_db
  ORCH -> STEPS : confirmOrder(orderId)
  STEPS -> INV : confirm()
  INV -> IDB : reservas → CONFIRMADA; stock -= qty
  STEPS -> ODB : pedido → CONFIRMADO; SagaStep OK; saga → COMPLETADA
end
STEPS --> PROJ : AFTER_SUCCESS → vistas actualizadas

Cliente -> API : GET /orders/{id} (polling)
note right : Responde desde query_db:\nPENDIENTE … CONFIRMADO
@enduml

@startuml saga-sequence-compensation
title SAGA de pedido — compensación por pago rechazado (CANCELADO / COMPENSADA)
skinparam shadowing false
skinparam defaultFontName Arial
autonumber "<b>0."

participant "OrderSagaOrchestrator" as ORCH
participant "OrderSagaSteps" as STEPS
participant "InventoryCommandService" as INV
participant "PaymentCommandService" as PAY
database "orders_db" as ODB
database "inventory_db" as IDB
database "payments_db" as PDB

note over ORCH : Pila de compensaciones:\n[CANCELAR_PEDIDO]

group Paso 1 — JTA XA: inventory_db + orders_db
  ORCH -> STEPS : reserveInventory(orderId, items)
  STEPS -> INV : reserve()
  INV -> IDB : reserved += qty; reservas RESERVADA
  STEPS -> ODB : pedido → INVENTARIO_RESERVADO; SagaStep OK
end
note over ORCH : push → [LIBERAR_INVENTARIO, CANCELAR_PEDIDO]

group Paso 2 — JTA XA (dontRollbackOn = PaymentRejectedException): payments_db + orders_db
  ORCH -> STEPS : processPayment(orderId, amount)
  STEPS -> PAY : process() → pasarela RECHAZA\n(paymentMethod = "FAIL" o monto > 5.000.000)
  PAY -> PDB : INSERT payments (RECHAZADO, reason)
  STEPS -> ODB : pedido → PAGO_RECHAZADO; SagaStep ERROR; saga → COMPENSANDO
  note over PDB, ODB : commit 2PC: el rechazo queda registrado en ambas bases
  STEPS -->> ORCH : throw PaymentRejectedException
end

== Compensaciones en orden inverso (LIFO), cada una idempotente y con hasta 3 reintentos ==

group C2 — JTA XA: inventory_db + orders_db
  ORCH -> STEPS : releaseInventory(orderId)
  STEPS -> INV : release()
  INV -> IDB : reserved -= qty; reservas → LIBERADA
  STEPS -> ODB : pedido → INVENTARIO_LIBERADO; SagaStep COMPENSAR OK
end

group C1 — JTA local: orders_db
  ORCH -> STEPS : cancelOrder(orderId)
  STEPS -> ODB : pedido → CANCELADO; SagaStep COMPENSAR OK; saga → COMPENSADA
end

alt una compensación falla 4 veces (1 intento + 3 reintentos)
  ORCH -> STEPS : markFailed()
  STEPS -> ODB : saga → FALLIDA (intervención manual)
end

note over ORCH
  Sin stock: el paso 1 hace rollback de inventory_db y orders_db,
  la pila solo contiene CANCELAR_PEDIDO ⇒ PENDIENTE → CANCELADO,
  saga COMPENSADA, no se llama al pago ni se libera inventario.
end note
@enduml
